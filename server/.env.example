# Скопіюй у .env і заповни.

# Google-акаунти з правами адміна (через кому).
ADMIN_EMAILS=you@gmail.com

# iOS client ID із Google Cloud. Якщо задано — бекенд перевіряє справжній Google ID-token.
# Якщо НЕ задано — dev-режим: Authorization: Bearer <email> трактується як ідентичність.
GOOGLE_CLIENT_ID=

# PORT=3000
# DATABASE_URL=./data.db

# Дозволити dev-вхід (Authorization: Bearer <email>) замість справжнього Google-токена.
# Потрібне лише для локальної розробки без GOOGLE_CLIENT_ID. На сервері, доступному
# ззовні, НЕ вмикати: це відкриє адмінку кожному, хто знає адресу з ADMIN_EMAILS.
# ALLOW_DEV_AUTH=1

# Куди складати скріншоти квитанцій. Замість власного сховища пересилаємо їх
# у приватний телеграм-чат: файли зберігає Телеграм, а заявка одразу видно там,
# де її й звіряють із випискою. Без цих змінних приймання скріншотів вимкнене.
# Бот створюється через @BotFather; chat_id приватного каналу — з мінусом і 100.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_RECEIPTS_CHAT_ID=
